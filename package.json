{
  "name": "toss-invest",
  "private": true,
  "scripts": {
    "generate": "pnpm --filter toss-sdk generate",
    "build": "pnpm -r build",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check . && pnpm typecheck",
    "test": "pnpm build && pnpm -r test",
    "test:live": "pnpm --filter toss-sdk test:live",
    "mcp:build": "pnpm build",
    "mcp:test": "pnpm build && pnpm --filter toss-invest-mcp test",
    "mcp:inspect": "pnpm build && pnpm dlx @modelcontextprotocol/inspector node --env-file=.env apps/mcp/dist/stdio.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6"
  }
}
