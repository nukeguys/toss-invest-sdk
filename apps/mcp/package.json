{
  "name": "@nukeguys/toss-invest-mcp",
  "version": "0.4.2",
  "mcpName": "io.github.nukeguys/toss-invest",
  "description": "Local MCP server for the Toss Securities Open API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nukeguys/toss-invest-sdk.git",
    "directory": "apps/mcp"
  },
  "homepage": "https://github.com/nukeguys/toss-invest-sdk#readme",
  "bugs": "https://github.com/nukeguys/toss-invest-sdk/issues",
  "keywords": [
    "toss",
    "securities",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "bin": {
    "toss-invest-mcp": "./dist/stdio.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "publish:registry": "mcp-publisher publish"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@nukeguys/toss-invest-sdk": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.1.2",
    "typescript": "6.0.3"
  }
}
