{
  "name": "@wi9ine/toss-invest-sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for the Toss Securities Open API",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wi9ine/toss-invest-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/wi9ine/toss-invest-sdk#readme",
  "bugs": "https://github.com/wi9ine/toss-invest-sdk/issues",
  "keywords": [
    "toss",
    "securities",
    "openapi",
    "typescript",
    "sdk"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test",
    "test:live": "pnpm build && node --env-file=../../.env scripts/smoke.ts"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "26.1.2",
    "typescript": "6.0.3"
  }
}
